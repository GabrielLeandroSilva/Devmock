# DevMock — gitignore (vault Obsidian + dev futuro)
# Mantém .md, templates e configs essenciais. Ignora cache/pessoal.

# Obsidian — workspace pessoal e cache
**/.obsidian/workspace.json
**/.obsidian/cache/
**/.obsidian/hotkeys.json
**/.obsidian/graph.json

# Smart Connections — embeddings locais (pesados, regeneráveis)
.smart-env/
**/.smart-env/
**/smart_connections.json

# Obsidian — plugins: mantém manifest + configs, ignora binários (reinstaláveis)
**/.obsidian/plugins/*/main.js
**/.obsidian/plugins/*/styles.css

# SO / editores
.DS_Store
Thumbs.db
*.tmp
*.bak
~$*

# Node / build futuro (quando o código DevMock nascer)
node_modules/
dist/
build/
coverage/
.env
.env.local
