{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "devmock: build (core + extension)",
      "type": "shell",
      "command": "npm run build:host",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": "$tsc"
    }
  ]
}
