{
  "name": "devmock-vscode",
  "displayName": "DevMock",
  "description": "API Contract & Mocking for Front-end — build without waiting for the backend.",
  "version": "0.7.0",
  "publisher": "devmock",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "devmock.init", "title": "DevMock: Initialize Project" },
      { "command": "devmock.start", "title": "DevMock: Start Mock Server" },
      { "command": "devmock.stop", "title": "DevMock: Stop Mock Server" }
    ],
    "viewsContainers": {
      "activitybar": [{ "id": "devmock", "title": "DevMock", "icon": "$(beaker)" }]
    },
    "views": {
      "devmock": [{ "id": "devmock.project", "name": "Project" }]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0"
  }
}
