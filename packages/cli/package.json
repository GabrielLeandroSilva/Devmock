{
  "name": "devmock-cli",
  "version": "0.8.0",
  "description": "CLI do DevMock (EAP 2.3 antecipado) — init/start sobre o Core",
  "type": "module",
  "bin": {
    "devmock": "./bin/devmock.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:coverage": "c8 --include=dist/cli.js --reporter=text --reporter=json-summary --check-coverage --lines 90 --functions 95 --branches 80 --statements 90 vitest run"
  },
  "devDependencies": {
    "@devmock/core": "*",
    "@types/node": "^22.0.0",
    "c8": "^12.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
