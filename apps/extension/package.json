{
  "name": "devmock-vscode",
  "displayName": "DevMock",
  "description": "API Contract & Mocking for Front-end — build without waiting for the backend.",
  "version": "1.1.1",
  "publisher": "devmock",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/GabrielLeandroSilva/Devmock.git"
  },
  "homepage": "https://github.com/GabrielLeandroSilva/Devmock#readme",
  "bugs": {
    "url": "https://github.com/GabrielLeandroSilva/Devmock/issues"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "mock",
    "api",
    "openapi",
    "contract",
    "frontend",
    "faker",
    "brasil"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devmock.init",
        "title": "DevMock: Initialize Project"
      },
      {
        "command": "devmock.start",
        "title": "DevMock: Start Mock Server"
      },
      {
        "command": "devmock.stop",
        "title": "DevMock: Stop Mock Server"
      },
      {
        "command": "devmock.refresh",
        "title": "DevMock: Refresh View",
        "icon": "$(refresh)"
      },
      {
        "command": "devmock.createSchema",
        "title": "DevMock: New Schema…"
      },
      {
        "command": "devmock.editSchema",
        "title": "DevMock: Edit Schema…"
      },
      {
        "command": "devmock.createApi",
        "title": "DevMock: Create API…"
      },
      {
        "command": "devmock.importApi",
        "title": "DevMock: Import OpenAPI…"
      },
      {
        "command": "devmock.generate",
        "title": "DevMock: Generate Fake Data…"
      },
      {
        "command": "devmock.saveFakeData",
        "title": "DevMock: Save Fake Data…"
      },
      {
        "command": "devmock.switchScenario",
        "title": "DevMock: Switch Scenario…"
      },
      {
        "command": "devmock.export",
        "title": "DevMock: Export Contract…"
      },
      {
        "command": "devmock.showLog",
        "title": "DevMock: Show Request Log"
      },
      {
        "command": "devmock.validate",
        "title": "DevMock: Validate Real API…"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "devmock.refresh",
          "when": "view == devmock.project",
          "group": "navigation"
        },
        {
          "command": "devmock.createSchema",
          "when": "view == devmock.project",
          "group": "navigation"
        },
        {
          "command": "devmock.start",
          "when": "view == devmock.project",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "devmock.editSchema",
          "when": "view == devmock.project && viewItem == schema",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devmock",
          "title": "DevMock",
          "icon": "$(beaker)"
        }
      ]
    },
    "views": {
      "devmock": [
        {
          "id": "devmock.project",
          "name": "Project"
        }
      ]
    }
  },
  "scripts": {
    "build": "npm run lint && node ./scripts/bundle.js",
    "build:host": "npm --prefix ../../packages/core run build && npm run build",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build && npm --prefix ../../packages/core run build && tsc -p test/tsconfig.test.json",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@devmock/core": "*"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.101.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "glob": "^13.0.6",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2"
  }
}
